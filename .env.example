# Plantilla sin credenciales. Copia a .env.local (ignorado por Git).
# Solo desarrollo: usa valores ficticios y una base desechable.
# Arranque: node --env-file=.env.local --run dev
# No copies variables de plataforma VERCEL* ni secretos de producción.

# Vacío = PGLite en memoria. Se pierde al reiniciar.
DATABASE_URL=
# Completar: contraseña local de 14–256 caracteres.
ADMIN_PASSWORD=
# Completar: secreto aleatorio local de al menos 32 caracteres.
ADMIN_SESSION_SECRET=
# Completar para 2FA: 32 bytes aleatorios en Base64, distintos al secreto de sesión.
ADMIN_TOTP_ENCRYPTION_KEY=
# Opcional; si se usa debe ser un origen HTTPS sin ruta.
SITE_URL=
# Opcional; sin plazo aprobado, dejar vacío. No activa borrados automáticos.
DATA_RETENTION_DAYS=

# Cloudflare Turnstile. Obtén ambas claves del mismo widget.
# La Site Key es pública y se incluye durante el build del cliente.
VITE_TURNSTILE_SITE_KEY=
# Secret Key privada: solo servidor, nunca usar prefijo VITE_.
TURNSTILE_SECRET_KEY=
# Hostname exacto del sitio registrado en Turnstile (sin protocolo ni ruta).
# En producción puede omitirse si SITE_URL contiene el hostname canónico correcto.
TURNSTILE_EXPECTED_HOSTNAME=

# Correo transaccional (Brevo). Opcional en desarrollo; sin configuración se omiten los envíos.
# API key privada del servidor. No usar prefijo VITE_.
BREVO_API_KEY=
# Dirección remitente verificada en Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Fundación Venezuela Nueva Esperanza
# Buzón interno que recibe avisos de nuevas solicitudes de voluntariado.
VOLUNTEER_NOTIFICATION_EMAIL=
