# Plantilla sin credenciales. Copia a .env.local (ignorado por Git).
# Solo desarrollo: usa valores ficticios y una base desechable.
# Arranque: node --env-file=.env.local --run dev
# No copies variables de plataforma VERCEL* ni secretos de producción.

# Vacío = PGLite en memoria. Se pierde al reiniciar.
DATABASE_URL=
# Completar: contraseña local de 14–256 caracteres.
ADMIN_PASSWORD=
# Completar: secreto aleatorio local de al menos 32 caracteres.
ADMIN_SESSION_SECRET=
# Completar para 2FA: 32 bytes aleatorios en Base64, distintos al secreto de sesión.
ADMIN_TOTP_ENCRYPTION_KEY=
# Opcional; si se usa debe ser un origen HTTPS sin ruta.
SITE_URL=
# Opcional; sin plazo aprobado, dejar vacío. No activa borrados automáticos.
DATA_RETENTION_DAYS=
